{
  "id": "petadopt-local-env",
  "name": "PetAdopt — LOCAL",
  "values": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "default",
      "enabled": true
    },
    {
      "key": "token",
      "value": "",
      "type": "secret",
      "enabled": true,
      "description": "Auto-filled after Login request"
    },
    {
      "key": "petId",
      "value": "",
