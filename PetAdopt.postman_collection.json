    {
      "name": "Adoptions",
      "description": "Adoption request workflow:\n\n1. **User** applies → `POST /adoption/:petId`\n2. **Admin** views all → `GET /adoption/admin`\n3. **Admin** approves/rejects → `PUT /adoption/:id`\n4. **User** checks status → `GET /adoption`\n\n> Approving a request auto-sets pet status to `adopted` and rejects all other pending requests for that pet.",
      "item": [
        {
          "name": "Apply for Adoption  [User]",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/adoption/{{petId}}",
              "host": ["{{baseUrl}}"],
              "path": ["adoption", "{{petId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I have a large yard and 5 years of experience with dogs. Bruno would have a wonderful home with me.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Submits an adoption application. **User token required.**\n\n- `message` is optional\n- Returns `400` if already applied or pet is already adopted\n- Sets pet status to `pending` on success"
          },
          "response": [
            {
              "name": "201 Created",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Content-Type", "value": "application/json" },
                  { "key": "Authorization", "value": "Bearer {{token}}" }
                ],
                "url": {
                  "raw": "{{baseUrl}}/adoption/{{petId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["adoption", "{{petId}}"]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"message\": \"I have a large yard...\"\n}"
                }
              },
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
